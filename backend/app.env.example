# Configuration for running the backend directly on the host (`make run`).
# Copy to app.env, which is gitignored.
#
# Under docker compose this file is absent and every value below arrives as an
# environment variable instead -- config.LoadConfig reads either, and treats a
# missing app.env as normal rather than as an error.

ENVIRONMENT=local
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Note the host: localhost, not the compose service name.
DATABASE_URL=postgres://wera:wera@localhost:5432/wera_chap_chap?sslmode=disable
MIGRATION_URL=file://db/migrations

# At least 32 characters -- NewJWTMaker refuses anything shorter.
JWT_SECRET=local-dev-secret-change-me-32chars
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=336h

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8080/api/payments/mpesa/callback

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=wera-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SEED_DEMO=true
