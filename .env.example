POSTGRES_DB=wera_chap_chap
POSTGRES_USER=wera
POSTGRES_PASSWORD=wera

# "local" permits the placeholder JWT_SECRET below. Any other value makes the
# backend refuse to start until JWT_SECRET is a real secret.
ENVIRONMENT=local

PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://wera:wera@postgres:5432/wera_chap_chap?sslmode=disable
MIGRATION_URL=file://db/migrations

# Must be at least 32 characters -- the token maker refuses a shorter key.
JWT_SECRET=replace-with-a-long-random-secret
# Durations, not bare numbers: "15m", "24h", "336h".
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=336h

VITE_API_URL=http://localhost:8080/api

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8080/api/payments/mpesa/callback

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=wera-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SEED_DEMO=true
